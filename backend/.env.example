APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_USER_NAME="Pantry Owner"
APP_USER_EMAIL=me@example.com
APP_USER_PASSWORD=password

# Only needed if pantry-mcp isn't a sibling directory of this backend, or its build
# output lives somewhere else. Defaults to ../pantry-mcp/dist/cronometer-bridge.js
# CRONOMETER_BRIDGE_PATH=
# Defaults to ../pantry-mcp/dist/food-nutrition-bridge.js
# CRONOMETER_FOOD_BRIDGE_PATH=
# Only needed if `uvx` isn't at ~/.local/bin/uvx, /usr/local/bin/uvx, or /usr/bin/uvx.
# CRONOMETER_UVX_PATH=
# Defaults to ../pantry-mcp/dist/chat-agent-bridge.js. Powers the in-app Chat tab
# (a billed-Anthropic-API fallback for when a user's Claude subscription is exhausted).
# ANTHROPIC_CHAT_BRIDGE_PATH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
